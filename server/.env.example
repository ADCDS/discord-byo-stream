# Copy to .env next to compose.yml.

# The wss:// URL clients use for LiveKit. It must be on the same host as the token
# server, because the plugin's Discord security policy only allows that host.
LIVEKIT_URL=wss://example.com/livekit

# Either set the LiveKit API key and secret...
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# ...or point LIVEKIT_YML at an existing livekit.yml to use its first key.
# LIVEKIT_YML=/path/to/livekit.yml

# User and group the container runs as; they must be able to read ./data/keys.json.
UID_GID=1000:1000
