# Copy to .env next to compose.yml.

# The wss:// URL clients use for LiveKit. It must be on the same host as the token
# service, because Discord's security policy is only opened for that one host.
LIVEKIT_URL=wss://streams.example.com/livekit

# Run the bundled LiveKit (see livekit.example.yml). Delete this line if you already
# run LiveKit elsewhere on this host.
COMPOSE_PROFILES=livekit

# Where the token service finds LiveKit's API key and secret: the first entry under
# keys: in a livekit.yml...
LIVEKIT_YML=./livekit.yml
# ...or set them directly instead:
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# User and group the token service runs as; they must be able to read data/keys.json.
UID_GID=1000:1000
